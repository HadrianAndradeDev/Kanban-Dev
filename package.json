{
  "name": "kanban-dev",
  "displayName": "Kanban Dev",
  "description": "Lightweight, fully local kanban board per workspace: columns, drag and drop, nested checklists and comments, no account and no leaving VS Code",
  "version": "0.0.3",
  "license": "MIT",
  "publisher": "HadrianAndrade",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/HadrianAndradeDev/Kanban-Dev.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": [
    "kanban",
    "board",
    "task",
    "todo",
    "project management",
    "productivity"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kanbanDev.open",
        "title": "Kanban Dev: Open Board"
      },
      {
        "command": "kanbanDev.newTask",
        "title": "Kanban Dev: New Task"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0"
  }
}
